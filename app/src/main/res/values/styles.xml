<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Boutons modernes -->
    <style name="ModernButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="PrimaryButton" parent="ModernButton">
        <item name="backgroundTint">@color/primary</item>
    </style>

    <style name="SecondaryButton" parent="ModernButton">
        <item name="backgroundTint">@color/secondary</item>
    </style>

    <!-- Textes -->
    <style name="HeadingText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SubheadingText">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
